# -----------------------------------------------
# Keep ONLY source code files, ignore everything else
# -----------------------------------------------

# Flutter/Dart build outputs
/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Android generated files
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/.gradle/
/android/local.properties
/android/key.properties
/android/app/google-services.json
**/android/gradlew
**/android/gradlew.bat
**/android/gradle/wrapper/gradle-wrapper.jar

# iOS generated files
/ios/Flutter/.last_build_id
/ios/Flutter/App.framework/
/ios/Flutter/Flutter.framework/
/ios/Flutter/Flutter.podspec
/ios/Flutter/Generated.xcconfig
/ios/Flutter/ephemeral/
/ios/Pods/
/ios/.symlinks/
/ios/Runner.xcworkspace/xcshareddata/
/ios/Runner/GeneratedPluginRegistrant.*

# macOS
/macos/Flutter/ephemeral/
/macos/Pods/

# Linux
/linux/flutter/generated_plugin_registrant.cc
/linux/flutter/generated_plugin_registrant.h
/linux/flutter/generated_plugins.cmake

# Windows
/windows/flutter/generated_plugin_registrant.cc
/windows/flutter/generated_plugin_registrant.h
/windows/flutter/generated_plugins.cmake

# Web
/web/favicon.png
/web/icons/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp files
*.log
*.class
*.pyc
*.swp
migrate_working_dir/
.buildlog/
.history
.svn/
.atom/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Lock file (pubspec.lock optional for apps — keeping it for reproducibility)
# pubspec.lock  ← intentionally NOT ignored (keeps dependency versions locked)
